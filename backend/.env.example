# --- Auth (Supabase) -------------------------------------------------------
# The backend verifies the JWT that Supabase Auth issues to the browser. It
# never issues or stores passwords itself (PRODUCT.md Section 5: use an
# established auth provider, don't build one).
#
# Supply EITHER of these, depending on how your Supabase project signs tokens:
#
#   1. Legacy / shared-secret projects — Dashboard > Settings > API > JWT Secret
SUPABASE_JWT_SECRET=
#   2. Projects using asymmetric signing keys — just the project URL; the
#      backend fetches the public JWKS from it.
SUPABASE_URL=https://your-project.supabase.co

# --- Dev auth escape hatch -------------------------------------------------
# When true, the API accepts "Authorization: Bearer dev:<userId>:<email>:<name>"
# so the whole product can be exercised without a Supabase project. It is OFF
# by default and must NEVER be enabled on a public deployment — it lets anyone
# claim any identity.
ALLOW_DEV_AUTH=false

# --- Database --------------------------------------------------------------
# Not yet used: this build stores data in memory behind an async repository
# interface. `db/schema.sql` has the Postgres schema for the swap.
DATABASE_URL=

PORT=4000
